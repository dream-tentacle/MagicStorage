<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef Name="MS_StorageBuildingBase" ParentName="BuildingBase" Abstract="True">
    <category>Building</category>
    <selectable>true</selectable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>40</pathCost>
    <fillPercent>0.5</fillPercent>
    <designationCategory>Misc</designationCategory>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <constructEffect>ConstructMetal</constructEffect>
    <repairEffect>Repair</repairEffect>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <drawerType>MapMeshOnly</drawerType>
    <building><isInert>true</isInert></building>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>1200</WorkToBuild>
      <Flammability>0.5</Flammability>
      <Mass>20</Mass>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="MS_StorageBuildingBase">
    <defName>MS_StorageCore</defName>
    <label>存储控制核心</label>
    <description>管理通过存储线连接的存储单元，统一设置接收类型和存储优先级。殖民者将物品送到相连的存储接收器，由核心分配到存储单元。普通搬运不会取出单元内的物品，专用取货口可按对应需求领取。修改筛选条件不会移出已有物品。同一网络只能有一个控制核心。\n\n可在核心的“查看物品”界面选择物品和数量，将其取出到核心周围。</description>
    <thingClass>MagicStorage.Building_StorageCore</thingClass>
    <size>(2,2)</size>
    <rotatable>false</rotatable>
    <graphicData>
      <texPath>Things/Building/Misc/MultiAnalyzer</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>2.46875</drawSize>
      <color>(0.65,0.85,1)</color>
    </graphicData>
    <comps><li Class="MagicStorage.CompProperties_StorageNode" /></comps>
    <inspectorTabs><li>ITab_Storage</li></inspectorTabs>
    <costList><Steel>80</Steel><ComponentIndustrial>4</ComponentIndustrial></costList>
    <uiOrder>3100</uiOrder>
  </ThingDef>

  <ThingDef ParentName="MS_StorageBuildingBase">
    <defName>MS_StorageUnit</defName>
    <label>存储单元</label>
    <description>保存物品的存储单元，提供64个堆叠槽位。物品遵循正常堆叠规则，存储期间暂停常规更新。断开连接不会清空已有物品。单元自身可以传导存储连接，无需在下方另外铺线。</description>
    <thingClass>MagicStorage.Building_StorageUnit</thingClass>
    <size>(1,2)</size>
    <rotatable>true</rotatable>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories><li>BuildingsMisc</li></thingCategories>
    <graphicData>
      <texPath>Things/Building/Power/Battery</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,3)</drawSize>
      <color>(0.6,0.85,1)</color>
    </graphicData>
    <comps><li Class="MagicStorage.CompProperties_StorageNode"><slotCapacity>64</slotCapacity></li></comps>
    <costList><Steel>60</Steel><ComponentIndustrial>2</ComponentIndustrial></costList>
    <uiOrder>3101</uiOrder>
  </ThingDef>

  <ThingDef ParentName="MS_StorageBuildingBase">
    <defName>MS_StorageFoodOutlet</defName>
    <label>食物取货口</label>
    <description>从相连的存储网络提供食物，用于进食、随身备餐、照顾病人和婴儿、给囚犯送饭以及驯服和训练动物。己方动物也可以到此取食。聚会进食和暴食遵循各自的行为规则。还可为营养膏料斗、生长舱和生物塑形舱提供所需食材。\n\n领取者必须到达取货口，食物按实际食用者或设备的需求选择。料斗的存储优先级需高于核心。无法供货时继续寻找原版来源。取货口自身不保存物品，不供应制作任务或远行队装载。</description>
    <thingClass>MagicStorage.Building_StorageFoodOutlet</thingClass>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <graphicData>
      <texPath>Things/Building/Misc/MultiAnalyzer</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.25</drawSize>
      <color>(0.55,1,0.65)</color>
    </graphicData>
    <comps><li Class="MagicStorage.CompProperties_StorageNode" /></comps>
    <costList><Steel>40</Steel><ComponentIndustrial>2</ComponentIndustrial></costList>
    <uiOrder>3103</uiOrder>
  </ThingDef>

  <ThingDef ParentName="MS_StorageBuildingBase">
    <defName>MS_StorageReceiver</defName>
    <label>存储接收器</label>
    <description>接收殖民者搬来的物品，交由相连的控制核心存入存储单元。提供10个暂存堆叠槽位，接收类型和优先级在核心上统一设置。\n\n网络无法工作或没有可用容量时停止接收，已经送到的物品保留在接收位置。暂存物品尚未进入单元，仍按地面物品处理。接收器自身可以传导存储连接。</description>
    <thingClass>MagicStorage.Building_StorageReceiver</thingClass>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <surfaceType>Item</surfaceType>
    <canOverlapZones>false</canOverlapZones>
    <building>
      <maxItemsInCell>10</maxItemsInCell>
      <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
    </building>
    <graphicData>
      <texPath>Things/Building/Misc/MultiAnalyzer</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.25</drawSize>
      <color>(0.55,0.8,1)</color>
    </graphicData>
    <comps><li Class="MagicStorage.CompProperties_StorageNode" /></comps>
    <costList><Steel>40</Steel><ComponentIndustrial>2</ComponentIndustrial></costList>
    <uiOrder>3104</uiOrder>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>MS_StorageConduit</defName>
    <label>存储线</label>
    <description>连接存储控制核心和存储单元的线路。沿上下左右相邻连接，可以铺设在允许下方走线的建筑下面。存储线独立于电网，不传输电力。</description>
    <thingClass>MagicStorage.Building_StorageConduit</thingClass>
    <category>Building</category>
    <altitudeLayer>Conduits</altitudeLayer>
    <selectable>true</selectable>
    <rotatable>false</rotatable>
    <clearBuildingArea>false</clearBuildingArea>
    <passability>Standable</passability>
    <designationCategory>Misc</designationCategory>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <drawerType>MapMeshOnly</drawerType>
    <building>
      <isEdifice>false</isEdifice>
      <isInert>true</isInert>
      <ai_chillDestination>false</ai_chillDestination>
      <canConstructInCorner>true</canConstructInCorner>
      <blueprintGraphicData>
        <texPath>Things/Building/Linked/PowerConduit_Blueprint_Atlas</texPath>
        <graphicClass>MagicStorage.Graphic_StorageConduit</graphicClass>
      </blueprintGraphicData>
    </building>
    <graphicData>
      <texPath>Things/Building/Linked/PowerConduit_Atlas</texPath>
      <graphicClass>MagicStorage.Graphic_StorageConduit</graphicClass>
      <color>(0.3,0.85,1)</color>
    </graphicData>
    <uiIconPath>Things/Building/Linked/PowerConduit_MenuIcon</uiIconPath>
    <uiIconScale>0.7</uiIconScale>
    <comps><li Class="MagicStorage.CompProperties_StorageNode" /></comps>
    <placeWorkers><li>MagicStorage.PlaceWorker_StorageConduit</li></placeWorkers>
    <constructEffect>ConstructMetal</constructEffect>
    <repairEffect>Repair</repairEffect>
    <costList><Steel>1</Steel></costList>
    <statBases><MaxHitPoints>80</MaxHitPoints><WorkToBuild>35</WorkToBuild><Flammability>0.5</Flammability></statBases>
    <uiOrder>3102</uiOrder>
  </ThingDef>
</Defs>
