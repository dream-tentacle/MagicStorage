<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="MS_StorageBuildingBase">
    <defName>MS_CaravanTeleporter</defName>
    <researchPrerequisites><li>MS_WarpTechnology</li></researchPrerequisites>
    <label>caravan teleporter</label>
    <description>Forms a caravan using supplies from the connected magic storage network. Once confirmed, the selected supplies are transferred to the caravan members' inventories, and the members immediately form a caravan on the world map.</description>
    <thingClass>MagicStorage.Building_CaravanTeleporter</thingClass>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories><li>BuildingsMisc</li></thingCategories>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <graphicData>
      <texPath>Things/Building/CaravanTeleporter/CaravanTeleporter</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.125,1.125)</drawSize>
      <color>(1,1,1)</color>
      <drawRotated>false</drawRotated>
      <drawOffset>(0,0,0)</drawOffset>
    </graphicData>
    <comps><li Class="MagicStorage.CompProperties_StorageNode" /></comps>
    <costList><Steel>60</Steel><ComponentIndustrial>2</ComponentIndustrial></costList>
    <uiOrder>3111</uiOrder>
  </ThingDef>
</Defs>
