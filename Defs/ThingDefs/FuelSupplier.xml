<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="MS_StorageBuildingBase">
    <defName>MS_FuelSupplier</defName>
    <researchPrerequisites><li>MS_MaterialSupplyTechnology</li></researchPrerequisites>
    <label>fuel supplier</label>
    <description>Automatically refuels buildings within 20 cells, including some turrets that use fuel mechanics.\n\nRefueling is not immediate. Following the base game rules, fuel usually needs to drop to 30% before refueling begins. The refueling threshold for turrets is usually 50%.</description>
    <thingClass>MagicStorage.Building_FuelSupplier</thingClass>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories><li>BuildingsMisc</li></thingCategories>
    <tickerType>Normal</tickerType>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <graphicData>
      <texPath>Things/Building/FuelSupplier/FuelSupplier</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.125,1.125)</drawSize>
      <color>(1,1,1)</color>
      <drawRotated>false</drawRotated>
      <drawOffset>(0,0,0)</drawOffset>
    </graphicData>
    <comps><li Class="MagicStorage.CompProperties_StorageNode" /></comps>
    <placeWorkers><li>MagicStorage.PlaceWorker_FuelSupplier</li></placeWorkers>
    <costList><Steel>60</Steel><ComponentIndustrial>2</ComponentIndustrial></costList>
    <uiOrder>3109</uiOrder>
  </ThingDef>
</Defs>
