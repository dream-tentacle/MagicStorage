<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="MS_StorageBuildingBase">
    <defName>MS_TransportSupplier</defName>
    <researchPrerequisites><li>MS_MaterialSupplyTechnology</li></researchPrerequisites>
    <label>material supplier</label>
    <description>Use this building to manually resupply or continuously supply shuttles, transport pods, refuelable facilities and other transport containers.\n\nBefore loading transport pods with a material supplier, select the pods you want to launch together and click the Create launch group button added by this mod. Then configure the items to supply. Once loaded, use the standard launch button.</description>
    <thingClass>MagicStorage.Building_TransportSupplier</thingClass>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories><li>BuildingsMisc</li></thingCategories>
    <tickerType>Normal</tickerType>
    <size>(1,1)</size>
    <rotatable>true</rotatable>
    <graphicData>
      <texPath>Things/Building/TransportSupplier/TransportSupplier</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1.125,1.125)</drawSize>
      <color>(1,1,1)</color>
      <drawRotated>false</drawRotated>
      <allowFlip>false</allowFlip>
      <drawOffset>(0,0,0)</drawOffset>
    </graphicData>
    <comps><li Class="MagicStorage.CompProperties_StorageNode" /></comps>
    <placeWorkers><li>MagicStorage.PlaceWorker_TransportSupplier</li></placeWorkers>
    <costList><Steel>60</Steel><ComponentIndustrial>2</ComponentIndustrial></costList>
    <uiOrder>3108</uiOrder>
  </ThingDef>
</Defs>
