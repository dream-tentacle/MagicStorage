<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="MS_StorageBuildingBase">
    <defName>MS_StorageSupplyShelf</defName>
    <label>auto-restocking shelf</label>
    <description>A small shelf that automatically restocks from its connected storage network, providing small quantities of food, medicine and other everyday supplies.\n\nStorage priority affects hauling of existing stock; colonists will not haul items into this shelf. Set its priority at least as high as the core's storage priority to avoid repeated hauling.</description>
    <thingClass>MagicStorage.Building_StorageSupplyShelf</thingClass>
    <tickerType>Normal</tickerType>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <surfaceType>Item</surfaceType>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories><li>BuildingsMisc</li></thingCategories>
    <building>
      <maxItemsInCell>3</maxItemsInCell>
      <preventDeteriorationOnTop>true</preventDeteriorationOnTop>
      <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
      <fixedStorageSettings>
        <filter>
          <disallowNotEverStorable>true</disallowNotEverStorable>
          <categories><li>Root</li></categories>
          <disallowedCategories><li>Chunks</li><li>Plants</li><li>Buildings</li></disallowedCategories>
          <disallowedThingDefs><li MayRequire="Ludeon.RimWorld.Biotech">Wastepack</li></disallowedThingDefs>
        </filter>
      </fixedStorageSettings>
    </building>
    <graphicData>
      <texPath>Things/Building/StorageSupplyShelf/StorageSupplyShelf</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.125,1.125)</drawSize>
      <color>(1,1,1)</color>
      <drawRotated>false</drawRotated>
      <drawOffset>(0,0,0)</drawOffset>
    </graphicData>
    <comps><li Class="MagicStorage.CompProperties_StorageNode" /></comps>
    <costList><Steel>40</Steel><ComponentIndustrial>2</ComponentIndustrial></costList>
    <uiOrder>3107</uiOrder>
  </ThingDef>
</Defs>
