<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Complex Jobs splits production into additional work types. Each entry
       enables both recipe discovery and dispatch through the shared work giver. -->
  <WorkGiverDef ParentName="MS_CosmicCraftingBase" MayRequire="FrozenSnowFox.ComplexJobs">
    <defName>MS_CosmicFSFButcher</defName>
    <label>宇宙工作台屠宰</label>
    <workType>FSFButcher</workType>
    <verb>屠宰</verb>
    <gerund>屠宰</gerund>
  </WorkGiverDef>
